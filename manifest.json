{
  "manifest_version": 3,
  "name": "Bili Digest 哔哩精读",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "把 B站视频变成学习资料：字幕、双语对照、AI 概览与带时间戳的笔记。",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "打开 Bili Digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
